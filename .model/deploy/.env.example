# open-webui (Web-Chat) — Konfiguration. Kopie nach .env, echte Werte NIE committen.
WEBUI_SECRET_KEY=change-me-openssl-rand-hex-24
PORT_HOST=3000
# Dummy-Key genügt (model-chat prüft keinen); frei wählbar:
MODEL_CHAT_KEY=sk-model-chat
